@startuml
' ============================================
' ACTIVITY DIAGRAM - Сквозной процесс "Оформление заказа"
' ============================================

start

:Пользователь открывает каталог;
:Добавляет товары в корзину;
:Нажимает "Оформить заказ";

fork

  :ШАГ 1: Обработка оплаты;
  
  if (Сумма <= лимит?) then (да)
    :Оплата успешна;
    :Статус → PAID;
  else (нет)
    :Ошибка оплаты;
    :Статус → FAILED;
    
    fork again
      :КОМПЕНСАЦИЯ:
      :Возврат средств;
      :Отмена резерва товаров;
      :Уведомление клиента;
    end fork
    
    :Статус → CANCELLED;
    stop
  endif

fork again

  :ШАГ 2: Проверка остатков;
  
  if (Товар в наличии?) then (да)
    :Резервирование товара;
  else (нет)
    #pink:Ошибка: товара нет;
    :Статус → FAILED;
    
    fork again
      :КОМПЕНСАЦИЯ:
      :Возврат средств;
      :Отмена резерва;
      :Уведомление;
    end fork
    
    :Статус → CANCELLED;
    stop
  endif

fork again

  :ШАГ 3: Отправка заказа;
  :Статус → SHIPPED;

fork again

  :ШАГ 4: Доставка;
  :Статус → DELIVERED;

end fork

:Уведомление клиента об успехе;
:Очистка корзины;

stop

@enduml