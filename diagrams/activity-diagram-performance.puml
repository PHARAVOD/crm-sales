@startuml
' ============================================
' ACTIVITY DIAGRAM - Оптимизация производительности
' С временными метками (ДО и ПОСЛЕ)
' ============================================

title Activity Diagram - Процесс "Оформление заказа" (с временами)

|Пользователь|
start
:Нажимает "Оформить заказ";
note right
  <b>Время реакции UI:</b>
  ДО: 100 мс
  ПОСЛЕ: 50 мс
end note

|Система|
fork

  |Каталог|
  :Загрузка товаров;
  note right
    <b>ДО:</b> 450 мс (без кэша)
    <b>ПОСЛЕ:</b> 50 мс (Redis кэш)
    <color:green>✅ Ускорение в 9x</color>
  end note

fork again

  |Корзина|
  :Добавление товара;
  note right
    <b>ДО:</b> 120 мс
    <b>ПОСЛЕ:</b> 50 мс
  end note

end fork

|Система|
:Параллельные вызовы (Task.WhenAll);

fork

  |Оплата|
  :ProcessPayment();
  note right
    <b>ДО:</b> 1500 мс (синхронно)
    <b>ПОСЛЕ:</b> 800 мс (асинхронно)
  end note

fork again

  |Склад|
  :CheckStock();
  note right
    <b>ДО:</b> 300 мс (последовательно)
    <b>ПОСЛЕ:</b> 150 мс (пакетно)
  end note

end fork

|Система|
if (Успех?) then (да)
  :Обновление статуса;
  note right
    <b>ДО:</b> 50 мс
    <b>ПОСЛЕ:</b> 30 мс
  end note
  
  :Отправка уведомления;
  
  stop
else (нет)
  :Компенсация (Saga);
  note right
    <b>ДО:</b> 500 мс
    <b>ПОСЛЕ:</b> 200 мс
  end note
  
  :Показ ошибки пользователю;
  
  stop
endif

|Пользователь|
:Получает результат;

@enduml